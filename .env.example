PORT=5000
MAX_UPLOAD_SIZE_MB=1024
CHUNK_DURATION_SECONDS=60
TEMP_DIR=/tmp/video-chunker
CLEANUP_INTERVAL_MINUTES=15
JOB_MAX_AGE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/chunkit

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-me
JWT_EXPIRES_IN=7d

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMTP (Email for OTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@chunkit.com
