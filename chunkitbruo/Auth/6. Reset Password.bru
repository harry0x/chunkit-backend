meta {
  name: 6. Reset Password
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/auth/reset-password
  body: json
  auth: none
}

body:json {
  {
    "email": "{{userEmail}}",
    "otp": "{{otp}}",
    "newPassword": "newpassword123"
  }
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
}
