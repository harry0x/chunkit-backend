meta {
  name: 2. Get Job Status
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/status/{{jobId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
  test("has a status field", function() {
    expect(res.body).to.have.property("status");
  });
}
