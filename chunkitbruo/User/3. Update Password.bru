meta {
  name: 3. Update Password
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/user/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "currentPassword": "{{userPassword}}",
    "newPassword": "newpassword456"
  }
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
}
